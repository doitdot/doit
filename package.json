{
  "name": "doit",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "docker compose up -d && pnpm --filter @doit/api dev",
    "dev:api": "pnpm --filter @doit/api dev",
    "dev:worker": "pnpm --filter @doit/api dev:worker",
    "dev:mobile": "pnpm --filter @doit/mobile start",
    "build": "pnpm --filter @doit/shared build && pnpm --filter @doit/api build",
    "build:shared": "pnpm --filter @doit/shared build",
    "build:api": "pnpm --filter @doit/api build",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:generate": "pnpm --filter @doit/api prisma generate",
    "db:migrate": "pnpm --filter @doit/api prisma migrate dev",
    "db:studio": "pnpm --filter @doit/api prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "clean": "pnpm --recursive clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
