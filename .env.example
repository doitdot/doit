# Node environment
NODE_ENV=development

# API
API_PORT=3000
API_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://doit:doit@localhost:5432/doit?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=doit-media
S3_REGION=us-east-1

# Keycloak (OIDC)
OIDC_ISSUER=http://localhost:8080/realms/doit
OIDC_CLIENT_ID=doit-api
OIDC_CLIENT_SECRET=dev-client-secret-change-me
OIDC_JWKS_URI=http://localhost:8080/realms/doit/protocol/openid-connect/certs

# WebSocket
WS_PORT=3001

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION=1d

# Mail (MailHog in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@doit.local

# Push notifications (leave empty for local dev)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
